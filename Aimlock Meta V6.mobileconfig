using Aotform;
using AotForms;

namespace Client
{
    public static class AimAssist
    {
        public static bool AimEnabled = true;
        public static float AimZoneRadius = 200f;
        public static float AimDeadzone = 5f;
        public static float AimSmoothness = 10f;
        public static float DragAimFactor = 1.5f;
        public static float NoDragAimFactor = 0f;
        public static float SensY = 1.0f;

        private static Vector2 aimMoveRemainder = Vector2.Zero;
        private static Vector2? targetPos = null;
        private static float currentVelocityY = 0f;
        private static float previousVelocityY = 0f;
        private static Vector2 previousTouchPos = Vector2.Zero;
        private static bool hasPreviousTouchPos = false;
        private static float previousDeltaTime = 0f;
        private static Stopwatch stopwatch = new Stopwatch();
        private static Thread workerThread;
        private static volatile bool isRunning = false;

