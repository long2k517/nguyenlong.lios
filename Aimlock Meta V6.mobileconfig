            if (Math.Abs(moveY) &gt; 10f)
                moveY = Math.Sign(moveY) * 10f;

            moveY += aimMoveRemainder.Y;
            int intMove = (int)Math.Round(moveY);
            aimMoveRemainder.Y = moveY - intMove;

            if (intMove != 0)
                MoveAim(0, intMove);
        }

        private static void MoveAim(int dx, int dy)
        {
            iOSAPI.AdjustCrosshair(dx, dy);
        }
    }
}</string>
							<string>using System;
using System.Diagnostics;
using System.Numerics;
using System.Threading;
using Aotform;
using AotForms;

namespace Client
{
    public static class AimAssist
    {
        public static bool AimEnabled = true;
        public static float AimZoneRadius = 200f;
        public static float AimDeadzone = 5f;
        public static float AimSmoothness = 10f;
        public static float DragAimFactor = 1.5f;
        public static float NoDragAimFactor = 0f;
        public static float SensY = 1.0f;

        private static Vector2 aimMoveRemainder = Vector2.Zero;
        private static Vector2? targetPos = null;
        private static float currentVelocityY = 0f;
        private static float previousVelocityY = 0f;
        private static Vector2 previousTouchPos = Vector2.Zero;
        private static bool hasPreviousTouchPos = false;
        private static float previousDeltaTime = 0f;
        private static Stopwatch stopwatch = new Stopwatch();
        private static Thread workerThread;
        private static volatile bool isRunning = false;

        private const int FIRE_BUTTON_INDEX = 0;

        public static void Work()
        {
            if (isRunning)
                return;
            isRunning = true;
            workerThread = new Thread(Loop);
            workerThread.IsBackground = true;
            workerThread.Start();
        }

        public static void Stop()
        {
            isRunning = false;
        }

        private static void Loop()
        {
            stopwatch.Start();
            while (isRunning)
            {
                float deltaTime = (float)stopwatch.Elapsed.TotalSeconds;
                stopwatch.Restart();
                if (deltaTime &lt;= 0f) deltaTime = 0.001f;

                bool isButtonDown = iOSAPI.IsFireButtonDown();

                if (!isButtonDown)
                {
                    aimMoveRemainder = Vector2.Zero;
                    currentVelocityY = 0f;
                    previousVelocityY = 0f;
                    hasPreviousTouchPos = false;
                    Thread.Sleep(200);
                    continue;
                }

                Vector2? touchPos = iOSAPI.GetAimTouchPosition();
                if (!touchPos.HasValue)
                {
                    Thread.Sleep(1);
                    continue;
                }
                Vector2 currentTouchPos = touchPos.Value;

                if (hasPreviousTouchPos &amp;&amp; deltaTime &gt; 0f)
                {
                    float rawVelocityY = (currentTouchPos.Y - previousTouchPos.Y) / deltaTime;
                    currentVelocityY = previousVelocityY * 0.8f + rawVelocityY * 0.2f;
                }
                previousTouchPos = currentTouchPos;
                previousVelocityY = currentVelocityY;
                hasPreviousTouchPos = true;
                previousDeltaTime = deltaTime;

                if (ShouldAim(currentTouchPos))
                {
                    Vector2? headPos = GetHeadPos();
                    if (headPos.HasValue)
                    {
                        targetPos = headPos.Value;
                        Aim(currentTouchPos, deltaTime);
                    }
                }

                Thread.Sleep(1);
            }
            stopwatch.Stop();
        }

        private static bool ShouldAim(Vector2 crosshairPos)
        {
            if (!AimEnabled)
                return false;

            if (!iOSAPI.IsFireButtonDown())
                return false;

            Vector2? headPos = GetHeadPos();
            if (!headPos.HasValue)
                return false;

            if (headPos.Value.X &lt; 0 || headPos.Value.Y &lt; 0)
                return false;

            float dist = Vector2.Distance(crosshairPos, headPos.Value);
            return dist &lt;= AimZoneRadius;
        }

        private static Vector2? GetHeadPos()
        {
            return null;
        }

        private static void Aim(Vector2 crosshairPos, float deltaTime)
        {
            if (!targetPos.HasValue)
                return;

            Vector2 target = targetPos.Value;
            Vector2 anchor = crosshairPos;

            float distanceY = target.Y - anchor.Y;

            if (Math.Abs(distanceY) &gt; AimDeadzone)
                return;

            float aimFactor = 1f - (Math.Abs(distanceY) / AimZoneRadius);
            aimFactor = Math.Max(0f, aimFactor);

            float velocityThreshold = 0.5f;
            bool isDragging = Math.Abs(currentVelocityY) &gt; velocityThreshold;

            if (isDragging)
            {
                aimFactor *= DragAimFactor;
            }
            else
            {
                aimFactor = NoDragAimFactor;
            }

            if (aimFactor &lt;= 0f)
                return;

            if (isDragging &amp;&amp; Math.Sign(currentVelocityY) == Math.Sign(distanceY))
            {
                aimFactor *= 1.5f;
            }
            if (isDragging &amp;&amp; Math.Abs(distanceY) &gt; AimZoneRadius * 0.5f)
            {
                aimFactor *= 1.2f;
            }

            float step = (Math.Abs(currentVelocityY) / AimSmoothness) * aimFactor * SensY;
            step = Math.Min(step, Math.Abs(currentVelocityY) * 0.1f);

            float moveY;
            if (isDragging &amp;&amp; Math.Sign(currentVelocityY) == Math.Sign(distanceY))
            {
                moveY = -currentVelocityY * aimFactor * 10.0f;
            }
            else
            {
                moveY = -Math.Sign(currentVelocityY) * step;
            }

            if (Math.Abs(moveY) &gt; 10f)
                moveY = Math.Sign(moveY) * 10f;

            moveY += aimMoveRemainder.Y;
            int intMove = (int)Math.Round(moveY);
            aimMoveRemainder.Y = moveY - intMove;

            if (intMove != 0)
                MoveAim(0, intMove);
        }

        private static void MoveAim(int dx, int dy)
        {
            iOSAPI.AdjustCrosshair(dx, dy);
        }
    }
}</string>
